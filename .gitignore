# macOS
.DS_Store
**/.DS_Store

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
.env

# Jupyter
.ipynb_checkpoints/

# VSCode
.vscode/

# Course Materials & Documents
# PDFs, Word docs and PowerPoints are blocked to prevent accidental sharing of
# copyrighted materials (professor slides, course syllabi, textbooks, exam papers).
# To force-add a specific file that is your own work: git add -f yourfile.pdf
*.pdf
*.docx
*.pptx
*.mp4
*.mov
*.icloud
*.png

# LaTeX build artifacts
*.fls
*.aux
*.log
*.fdb_latexmk
*.synctex.gz
*.out
*.toc
*.bbl
*.blg
*.nav
*.snm
*.vrb
*.lof
*.lot
*.run.xml
*.bcf

# Local-only private files
# Put any files you want to keep ONLY on your own computer in the _lokaal/ folder.
# Git will never track or push anything inside it (except _lokaal/README.md).
_lokaal/**
!_lokaal/README.md

*.json
*.css
*.woff
*.woff2
*.js
*.svg
*.ttf
*.eot
*.map